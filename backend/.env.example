# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection String
MONGO_URI=mongodb://127.0.0.1:27017/reels_recommender

# Redis Connection URL (optional: falls back to in-memory cache if unreachable)
REDIS_URL=redis://127.0.0.1:6379

# Groq API Key (Llama-3.3-70b-versatile)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Cloudinary Credentials (Required for video uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
