{
  "name": "reels-interest-recommender",
  "version": "1.0.0",
  "description": "Reels Interest-Recommender Backend with Groq LLM, MongoDB, Redis, and Cloudinary",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --no-warnings --test tests/**/*.test.js",
