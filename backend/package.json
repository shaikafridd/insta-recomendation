    "express-rate-limit": "^8.6.2",
    "groq-sdk": "^0.15.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
